
@model IEnumerable<SupplierView.Models.Package>

@{
    ViewData["Title"] = "My Packages";
}

<div class="container mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <h2 class="fw-bold mb-1">My Packages</h2>
            <p class="text-muted mb-0">
                Manage your event packages and included services.
            </p>
        </div>

        <div class="d-flex gap-2">
            <a asp-controller="Supplier"
               asp-action="Index"
               class="btn btn-outline-secondary">
                Back to Dashboard
            </a>

            <a asp-controller="Supplier"
               asp-action="CreatePackage"
               class="btn btn-primary">
                + Add Package
            </a>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="px-3 py-3">Package Name</th>
                            <th class="py-3">Included Services</th>
                            <th class="py-3">Price</th>
                            <th class="py-3">Status</th>
                            <th class="text-center py-3">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model.Any())
                        {
                            @foreach (var package in Model)
                            {
                                <tr>
                                    <td class="px-3 fw-semibold">
                                        @package.Name
                                    </td>

                                    <td>
                                        @package.Description
                                    </td>

                                    <td class="fw-semibold text-nowrap">
                                        ₱@package.Price.ToString("N2")
                                    </td>

                                    <td>
                                        @if (package.IsActive)
                                        {
                                            <span class="badge rounded-pill bg-success-subtle text-success border border-success-subtle">
                                                Active
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge rounded-pill bg-secondary-subtle text-secondary border">
                                                Inactive
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        <div class="d-flex justify-content-center gap-2">
                                            <a asp-controller="Supplier"
                                               asp-action="EditPackage"
                                               asp-route-id="@package.Id"
                                               class="btn btn-sm btn-outline-primary">
                                                Edit
                                            </a>

                                            <form asp-controller="Supplier"
                                                  asp-action="DeletePackage"
                                                  asp-route-id="@package.Id"
                                                  method="post"
                                                  onsubmit="return confirm('Are you sure you want to delete this package?');">
                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-danger">
                                                    Delete
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center py-5">
                                    <h5 class="mb-2">No packages yet</h5>
                                    <p class="text-muted mb-3">
                                        Add your first event package to get started.
                                    </p>
                                    <a asp-controller="Supplier"
                                       asp-action="CreatePackage"
                                       class="btn btn-primary">
                                        + Add Package
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
