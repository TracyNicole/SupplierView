
@model SupplierView.Models.Package

@{
    ViewData["Title"] = "Add Package";
}

<div class="container mt-4">
    <h2>Add Package</h2>
    <p>Enter the details of your event package.</p>

    <form asp-controller="Supplier"
          asp-action="CreatePackage"
          method="post">

        <div asp-validation-summary="ModelOnly"
             class="text-danger"></div>

        <div class="mb-3">
            <label asp-for="Name" class="form-label">Package Name</label>
            <input asp-for="Name" class="form-control"
                   placeholder="e.g. Birthday Package" />
            <span asp-validation-for="Name"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Description" class="form-label">Description</label>
            <textarea asp-for="Description" class="form-control"
                      rows="3"
                      placeholder="Describe what's included"></textarea>
            <span asp-validation-for="Description"
                  class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Price" class="form-label">Price (₱)</label>
            <input asp-for="Price" type="number" step="0.01"
                   min="0" class="form-control" />
            <span asp-validation-for="Price"
                  class="text-danger"></span>
        </div>

        <div class="form-check mb-3">
            <input asp-for="IsActive" class="form-check-input" />
            <label asp-for="IsActive" class="form-check-label">
                Active Package
            </label>
        </div>

        <button type="submit" class="btn btn-primary">Save Package</button>

        <a asp-controller="Supplier"
           asp-action="Packages"
           class="btn btn-secondary">Cancel</a>
    </form>
</div>
