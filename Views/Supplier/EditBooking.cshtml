
@model SupplierView.Models.Booking

@{
    ViewData["Title"] = "Edit Booking";
    Layout = "~/Views/Supplier/_SupplierLayout.cshtml";
}

<div class="container-fluid">
    <div class="mb-4">
        <h2 class="fw-bold" style="color: #252b42;">Edit Booking</h2>
        <p class="text-secondary">Update the booking information below.</p>
    </div>

    <div class="card border-0 shadow-sm" style="border-radius: 12px;">
        <div class="card-body p-4">
            <form asp-action="EditBooking"
                  asp-route-id="@Model.Id"
                  method="post">

                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="CustomerName" class="form-label">
                        Customer Name
                    </label>
                    <input asp-for="CustomerName" class="form-control" />
                    <span asp-validation-for="CustomerName"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="EventType" class="form-label">
                        Event Type
                    </label>
                    <input asp-for="EventType" class="form-control" />
                    <span asp-validation-for="EventType"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="EventDate" class="form-label">
                        Event Date
                    </label>
                    <input asp-for="EventDate"
                           type="date"
                           class="form-control" />
                    <span asp-validation-for="EventDate"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="PackageName" class="form-label">
                        Package
                    </label>
                    <input asp-for="PackageName" class="form-control" />
                    <span asp-validation-for="PackageName"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="TotalPrice" class="form-label">
                        Total Price (₱)
                    </label>
                    <input asp-for="TotalPrice"
                           type="number"
                           step="0.01"
                           class="form-control" />
                    <span asp-validation-for="TotalPrice"
                          class="text-danger"></span>
                </div>

                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-primary">
                        Save Changes
                    </button>
                    <a asp-action="Bookings"
                       class="btn btn-outline-secondary">
                        Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>
