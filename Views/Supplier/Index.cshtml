
@using SupplierView.Models

@{
    ViewData["Title"] = "Supplier Dashboard";
    Layout = "~/Views/Supplier/_SupplierLayout.cshtml";

    var recentBookings = ViewBag.RecentBookings as List<Booking>
        ?? new List<Booking>();

    decimal totalEarnings = ViewBag.TotalEarnings is decimal earnings
        ? earnings
        : 0m;
}

<style>
    .dashboard-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 16px;
        margin-bottom: 30px;
    }

    .dashboard-header h1 {
        font-size: 28px;
        font-weight: 700;
        color: #252b42;
        margin-bottom: 6px;
    }

    .supplier-muted {
        color: #777e91;
        margin: 0;
    }

    .supplier-profile {
        background: white;
        padding: 10px 16px;
        border-radius: 10px;
        font-weight: 600;
    }

    .supplier-stats {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 18px;
        margin-bottom: 28px;
    }

    .supplier-card,
    .supplier-panel {
        background: white;
        border-radius: 14px;
        padding: 22px;
        box-shadow: 0 3px 15px rgba(30, 35, 70, 0.04);
    }

    .supplier-stat-label {
        color: #777e91;
        font-size: 14px;
        margin-bottom: 14px;
    }

    .supplier-stat-value {
        font-size: 28px;
        font-weight: 700;
        color: #252b42;
        margin: 0;
    }

    .supplier-lower {
        display: grid;
        grid-template-columns: minmax(0, 1.6fr) minmax(240px, 1fr);
        gap: 22px;
    }

    .supplier-panel h2 {
        font-size: 19px;
        font-weight: 700;
        margin-bottom: 20px;
        color: #252b42;
    }

    .supplier-empty {
        color: #777e91;
        font-size: 14px;
        padding: 8px 0;
    }

    .supplier-status {
        display: inline-block;
        padding: 5px 9px;
        border-radius: 20px;
        font-size: 12px;
        white-space: nowrap;
    }

    .status-pending {
        background: #fff2d6;
        color: #946200;
    }

    .status-confirmed {
        background: #dbeafe;
        color: #1d4ed8;
    }

    .status-completed {
        background: #dcfce7;
        color: #166534;
    }

    .status-cancelled {
        background: #e5e7eb;
        color: #374151;
    }

    @@media (max-width: 1000px) {
        .supplier-stats {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .supplier-lower {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 500px) {
        .supplier-stats {
            grid-template-columns: 1fr;
        }

        .supplier-card,
        .supplier-panel {
            padding: 16px;
        }

        .supplier-stat-value {
            font-size: 23px;
        }
    }
</style>

<div class="container-fluid">

    <!-- Dashboard Header -->
    <header class="dashboard-header">
        <div>
            <h1>Dashboard Overview</h1>
            <p class="supplier-muted">
                Welcome back! Here's what's happening with your business.
            </p>
        </div>

        <div class="supplier-profile">Supplier Account</div>
    </header>

    <!-- Dashboard Statistics -->
    <section class="supplier-stats">

        <div class="supplier-card">
            <div class="supplier-stat-label">Total Packages</div>
            <p class="supplier-stat-value">
                @(ViewBag.TotalPackages ?? 0)
            </p>
        </div>

        <div class="supplier-card">
            <div class="supplier-stat-label">Active Services</div>
            <p class="supplier-stat-value">
                @(ViewBag.ActiveServices ?? 0)
            </p>
        </div>

        <div class="supplier-card">
            <div class="supplier-stat-label">Total Bookings</div>
            <p class="supplier-stat-value">
                @(ViewBag.TotalBookings ?? 0)
            </p>
        </div>

        <div class="supplier-card">
            <div class="supplier-stat-label">Completed Booking Value</div>
            <p class="supplier-stat-value">
                ₱@totalEarnings.ToString("N2")
            </p>
        </div>

    </section>

    <!-- Recent Bookings and Inquiries -->
    <section class="supplier-lower">

        <div class="supplier-panel">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
                <h2 class="mb-0">Recent Bookings</h2>

                <a asp-controller="Supplier"
                   asp-action="Bookings"
                   class="btn btn-sm btn-outline-primary">
                    View All
                </a>
            </div>

            @if (recentBookings.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Customer</th>
                                <th>Event</th>
                                <th>Date</th>
                                <th>Status</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var booking in recentBookings)
                            {
                                var statusClass = booking.Status switch
                                {
                                    "Confirmed" => "status-confirmed",
                                    "Completed" => "status-completed",
                                    "Cancelled" => "status-cancelled",
                                    _ => "status-pending"
                                };

                                <tr>
                                    <td>@booking.CustomerName</td>
                                    <td>@booking.EventType</td>
                                    <td>
                                        @booking.EventDate.ToString("MMM dd, yyyy")
                                    </td>
                                    <td>
                                        <span class="supplier-status @statusClass">
                                            @booking.Status
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="supplier-empty">
                    No bookings found yet. Customer bookings will appear here
                    when records are available in the database.
                </p>
            }
        </div>

        <div class="supplier-panel">
            <h2>Inquiries</h2>

            <div>
                <strong>Customer Inquiries</strong>
                <p class="supplier-empty">
                    Customer questions and requests will appear here once
                    the inquiry feature is connected to the database.
                </p>
            </div>
        </div>

    </section>

</div>
