
@model SupplierView.Models.Booking

@{
    ViewData["Title"] = "Update Booking Status";
    Layout = "~/Views/Supplier/_SupplierLayout.cshtml";
}

<div class="container-fluid">
    <div class="mb-4">
        <h2 class="fw-bold" style="color: #252b42;">
            Update Booking Status
        </h2>
        <p class="text-secondary">
            Change the current status of this booking.
        </p>
    </div>

    <div class="card border-0 shadow-sm"
         style="border-radius: 12px; max-width: 650px;">
        <div class="card-body p-4">
            <h5 class="fw-bold mb-3">Booking #@Model.Id</h5>

            <p>
                <strong>Customer:</strong> @Model.CustomerName
            </p>
            <p>
                <strong>Event:</strong> @Model.EventType
            </p>
            <p>
                <strong>Current Status:</strong> @Model.Status
            </p>

            <hr />

            <form asp-action="UpdateBookingStatus"
                  asp-route-id="@Model.Id"
                  method="post">

                @Html.AntiForgeryToken()

                <div class="mb-4">
                    <label for="status" class="form-label">
                        New Status
                    </label>

                    <select id="status" name="status"
                            class="form-select" required>
                        <option value="Pending"
                                selected="@(Model.Status == "Pending")">
                            Pending
                        </option>
                        <option value="Confirmed"
                                selected="@(Model.Status == "Confirmed")">
                            Confirmed
                        </option>
                        <option value="Completed"
                                selected="@(Model.Status == "Completed")">
                            Completed
                        </option>
                        <option value="Cancelled"
                                selected="@(Model.Status == "Cancelled")">
                            Cancelled
                        </option>
                    </select>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        Save Status
                    </button>
                    <a asp-action="Bookings"
                       class="btn btn-outline-secondary">
                        Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>
