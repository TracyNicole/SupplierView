
@model IEnumerable<SupplierView.Models.Booking>

@{
    ViewData["Title"] = "Bookings";
    Layout = "~/Views/Supplier/_SupplierLayout.cshtml";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold" style="color: #252b42;">Bookings</h2>
            <p class="text-secondary mb-0">
                Manage and view your event bookings here.
            </p>
        </div>
    </div>

    <div class="card border-0 shadow-sm" style="border-radius: 12px;">
        <div class="card-body p-4">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead style="background-color: #f5f6fa;">
                        <tr>
                            <th>Booking ID</th>
                            <th>Customer Name</th>
                            <th>Event Type</th>
                            <th>Event Date</th>
                            <th>Package</th>
                            <th>Total Price</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var booking in Model)
                            {
                                <tr>
                                    <td>@booking.Id</td>
                                    <td>@booking.CustomerName</td>
                                    <td>@booking.EventType</td>
                                    <td>@booking.EventDate.ToString("MMM dd, yyyy")</td>
                                    <td>@booking.PackageName</td>
                                    <td>₱@booking.TotalPrice.ToString("N2")</td>
                                    <td>
                                        <span class="badge bg-warning text-dark">
                                            @booking.Status
                                        </span>
                                    </td>
                                    <td>
                                        <div class="d-flex flex-wrap gap-1">
                                            <a asp-action="BookingDetails"
                                               asp-route-id="@booking.Id"
                                               class="btn btn-sm btn-outline-primary">
                                                View
                                            </a>

                                            <a asp-action="EditBooking"
                                               asp-route-id="@booking.Id"
                                               class="btn btn-sm btn-outline-warning">
                                                Edit
                                            </a>

                                            <a asp-action="UpdateBookingStatus"
                                               asp-route-id="@booking.Id"
                                               class="btn btn-sm btn-outline-success">
                                                Status
                                            </a>

                                            <form asp-action="DeleteBooking"
                                                  asp-route-id="@booking.Id"
                                                  method="post"
                                                  onsubmit="return confirm('Delete this booking?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-danger">
                                                    Delete
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center text-secondary py-4">
                                    No bookings found yet.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
